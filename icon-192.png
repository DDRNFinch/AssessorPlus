:root{--p950:#2e1065;--p900:#3b0764;--p800:#5b21b6;--p700:#6d28d9;--p600:#7c3aed;--p100:#ede9fe;--bg:#f6f4fb;--ink:#172033;--muted:#6b7280;--line:#e6e1ef;--white:#fff;--safe:env(safe-area-inset-bottom,0px)}*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;background:var(--bg);color:var(--ink)}button,input,select{font:inherit}button{cursor:pointer}.app-shell{min-height:100dvh;padding-bottom:calc(78px + var(--safe))}.topbar{position:sticky;top:0;z-index:10;display:flex;align-items:center;justify-content:space-between;padding:calc(14px + env(safe-area-inset-top,0px)) 18px 14px;color:#fff;background:linear-gradient(135deg,var(--p950),var(--p700));box-shadow:0 8px 25px #2e106533}.brand{display:flex;gap:12px;align-items:center}.brand-mark{width:48px;height:48px;display:grid;place-items:center;border-radius:15px;background:#ffffff1f;border:1px solid #ffffff33;font-weight:900;font-size:21px}.brand h1{margin:0;font-size:20px}.brand p{margin:3px 0 0;color:#ffffffbd;font-size:12px}.ghost{border:0;border-radius:11px;padding:10px 13px;background:#ffffff22;color:#fff;font-weight:800}.content{width:min(100%,1080px);margin:auto;padding:22px 15px 32px;outline:0}.page{display:none}.page.active{display:block;animation:in .16s ease-out}@keyframes in{from{opacity:.3;transform:translateY(5px)}}.hero{padding:24px;border-radius:24px;color:#fff;background:linear-gradient(145deg,var(--p900),var(--p600));box-shadow:0 15px 38px #2e106526}.hero h2{margin:5px 0 8px;font-size:clamp(25px,6vw,38px)}.hero p:last-child{margin-bottom:0;color:#ffffffd0}.eyebrow{margin:0;color:var(--p700);font-size:11px;letter-spacing:.12em;font-weight:900}.hero .eyebrow{color:#ddd6fe}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:15px 0}.stats article{display:flex;flex-direction:column;gap:3px;padding:15px;text-align:center;border:1px solid var(--line);border-radius:17px;background:#fff}.stats strong{font-size:22px;color:var(--p700)}.stats span{font-size:11px;color:var(--muted)}.section-title{margin:22px 2px 11px;font-size:17px}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.tile{min-height:142px;display:flex;flex-direction:column;align-items:flex-start;gap:7px;padding:17px;text-align:left;border:1px solid var(--line);border-radius:20px;background:#fff;color:var(--ink);box-shadow:0 8px 22px #2e10650d}.tile b{width:40px;height:40px;display:grid;place-items:center;border-radius:13px;background:var(--p100);color:var(--p700);font-size:20px}.tile small{color:var(--muted);line-height:1.35}.page-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}.page-head h2{margin:4px 0 0;font-size:28px}.primary,.secondary{border:0;border-radius:12px;padding:11px 15px;font-weight:800}.primary{background:var(--p700);color:#fff}.secondary{background:var(--p100);color:var(--p800)}.stack{display:grid;gap:11px}.card{border:1px solid var(--line);border-radius:18px;background:#fff;padding:16px;box-shadow:0 6px 18px #2e10650a}.card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.card h3{margin:0 0 5px}.meta{display:flex;flex-wrap:wrap;gap:7px;margin-top:12px}.pill{display:inline-flex;padding:5px 9px;border-radius:999px;background:var(--p100);color:var(--p800);font-size:11px;font-weight:800}.muted{color:var(--muted);font-size:13px}.card-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}.small-btn{border:0;border-radius:10px;padding:8px 11px;background:#f2eff8;color:var(--p800);font-weight:750}.small-btn.danger{color:#b42318;background:#fff0ef}.empty{min-height:290px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:26px;text-align:center;border:2px dashed #d9d1e9;border-radius:23px;background:#ffffffb8}.empty>div{width:48px;height:48px;display:grid;place-items:center;border-radius:15px;background:var(--p700);color:#fff;font-weight:900}.empty h3{margin:15px 0 7px}.empty p{max-width:520px;margin:0 0 13px;color:var(--muted);line-height:1.5}.search{display:flex;align-items:center;gap:8px;margin-bottom:13px;padding:0 13px;border:1px solid var(--line);border-radius:14px;background:#fff}.search input{width:100%;padding:12px 0;border:0;outline:0;background:transparent}.learner-id{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-weight:900;letter-spacing:.08em;color:var(--p700)}.list{overflow:hidden;border:1px solid var(--line);border-radius:19px;background:#fff}.list button,.import-row{width:100%;min-height:72px;display:flex;align-items:center;justify-content:space-between;padding:13px 16px;border:0;border-bottom:1px solid var(--line);background:#fff;text-align:left;color:var(--ink)}.list>*:last-child{border-bottom:0}.list strong,.list small{display:block}.list small{margin-top:4px;color:var(--muted)}.list i{font-style:normal;font-size:23px;color:var(--muted)}.danger-row strong{color:#b42318}.bottom-nav{position:fixed;z-index:20;left:0;right:0;bottom:0;display:grid;grid-template-columns:repeat(5,1fr);padding:8px 4px calc(7px + var(--safe));background:#fffffff4;border-top:1px solid var(--line);backdrop-filter:blur(15px)}.nav{display:flex;flex-direction:column;align-items:center;gap:3px;padding:4px 1px;border:0;background:transparent;color:#7b8190}.nav b{font-size:20px}.nav small{font-size:10px;font-weight:800}.nav.active{color:var(--p700)}dialog{width:min(92vw,520px);border:0;border-radius:22px;padding:0;box-shadow:0 25px 80px #16082e66}dialog::backdrop{background:#16082e99}.modal{padding:22px}.modal-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:18px}.modal-head h2{margin:3px 0 0}.close{border:0;background:#f2eff8;color:var(--p800);width:36px;height:36px;border-radius:11px;font-size:24px}.modal label{display:grid;gap:6px;margin:12px 0;font-size:13px;font-weight:750}.modal input,.modal select{width:100%;padding:11px 12px;border:1px solid #d8d1e5;border-radius:11px;background:#fff;color:var(--ink)}.two{display:grid;grid-template-columns:1fr 1fr;gap:11px}.actions{display:flex;justify-content:flex-end;gap:9px;margin-top:19px}.qr-modal{text-align:center}.qr-modal .modal-head{text-align:left}.qr-box{width:220px;height:220px;display:grid;place-items:center;margin:5px auto 15px;padding:10px;border:1px solid var(--line);border-radius:16px;background:#fff}.qr-box img,.qr-box canvas{max-width:100%;height:auto}.id-label{margin:0;color:var(--muted);font-size:12px}.big-id{margin:5px 0;font:900 25px ui-monospace,monospace;letter-spacing:.12em;color:var(--p700)}.help{color:var(--muted);line-height:1.45;font-size:13px}.toast{position:fixed;z-index:100;left:50%;bottom:92px;transform:translate(-50%,20px);padding:11px 15px;border-radius:12px;background:#211331;color:#fff;font-size:13px;opacity:0;pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}@media(min-width:760px){.content{padding:30px 24px}.grid{grid-template-columns:repeat(4,1fr)}.bottom-nav{left:50%;right:auto;bottom:14px;width:min(720px,calc(100% - 30px));transform:translateX(-50%);border:1px solid var(--line);border-radius:21px}.app-shell{padding-bottom:105px}}@media(max-width:430px){.two{grid-template-columns:1fr}.primary{padding:10px 12px}.page-head h2{font-size:25px}}