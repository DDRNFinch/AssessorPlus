import{load,save,exportData,importData,clearAll}from"./storage.js";let data=load(),deferred=null;const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));function uid(){return crypto.randomUUID?.()||`${Date.now()}-${Math.random()}`}function learnerId(){const used=new Set(data.learners.map(x=>x.linkId));let id;do{id=String(Math.floor(1e9+Math.random()*9e9))}while(used.has(id));return id}function toast(msg){const t=$("#toast");t.textContent=msg;t.classList.add("show");clearTimeout(t._timer);t._timer=setTimeout(()=>t.classList.remove("show"),2200)}function showPage(name){if(!$( `.page[data-page="${name}"]`))name="dashboard";$$('.page').forEach(x=>x.classList.toggle('active',x.dataset.page===name));$$('.nav').forEach(x=>x.classList.toggle('active',x.dataset.pageTarget===name));history.replaceState({},'',`#${name}`);window.scrollTo(0,0);render()}function closeDialogs(){$$('dialog[open]').forEach(d=>d.close())}function fmtDate(){return new Intl.DateTimeFormat('en-GB',{weekday:'long',day:'numeric',month:'long',year:'numeric'}).format(new Date())}function className(id){return data.classes.find(c=>c.id===id)?.name||'Not assigned'}function render(){const p=data.profile;$("#welcomeTitle").textContent=p.name?`Good ${greeting()}, ${p.name.split(' ')[0]}`:'Welcome to Assessor+';$("#todayText").textContent=fmtDate();$("#headerSubtitle").textContent=[p.college,p.department].filter(Boolean).join(' · ')||'Teaching and assessment workspace';$("#classCount").textContent=data.classes.length;$("#learnerCount").textContent=data.learners.length;$("#profileSummary").textContent=p.name?[p.name,p.college,p.department].filter(Boolean).join(' · '):'Set your name, college and department';renderClasses();renderLearners();fillClassSelect()}function greeting(){const h=new Date().getHours();return h<12?'morning':h<18?'afternoon':'evening'}function renderClasses(){const list=$("#classesList"),empty=$("#classesEmpty");empty.hidden=data.classes.length>0;list.innerHTML=data.classes.map(c=>{const count=data.learners.filter(l=>l.classId===c.id).length;return`<article class="card"><div class="card-top"><div><h3>${esc(c.name)}</h3><div class="muted">${esc(c.course||'Course not set')}</div></div><span class="pill">${count} learner${count===1?'':'s'}</span></div><div class="meta"><span class="pill">${esc(c.day)}</span><span class="pill">${esc(c.start)}–${esc(c.finish)}</span>${c.room?`<span class="pill">${esc(c.room)}</span>`:''}</div><div class="card-actions"><button class="small-btn" data-edit-class="${c.id}">Edit</button><button class="small-btn danger" data-delete-class="${c.id}">Delete</button></div></article>`}).join('')}function renderLearners(){const q=$("#learnerSearch").value.trim().toLowerCase(),list=$("#learnersList"),empty=$("#learnersEmpty");const learners=data.learners.filter(l=>`${l.firstName} ${l.surname} ${l.course} ${l.linkId}`.toLowerCase().includes(q)).sort((a,b)=>`${a.surname}${a.firstName}`.localeCompare(`${b.surname}${b.firstName}`));empty.hidden=data.learners.length>0;list.innerHTML=learners.map(l=>`<article class="card"><div class="card-top"><div><h3>${esc(l.firstName)} ${esc(l.surname)}</h3><div class="muted">${esc(l.course||'Course not set')} · ${esc(className(l.classId))}</div></div><span class="learner-id">${esc(l.linkId)}</span></div>${l.employer?`<div class="meta"><span class="pill">${esc(l.employer)}</span></div>`:''}<div class="card-actions"><button class="small-btn" data-show-qr="${l.id}">Show ID & QR</button><button class="small-btn" data-edit-learner="${l.id}">Edit</button><button class="small-btn danger" data-delete-learner="${l.id}">Delete</button></div></article>`).join('')}function fillClassSelect(){const current=$("#learnerClass").value;$("#learnerClass").innerHTML='<option value="">Not assigned</option>'+data.classes.map(c=>`<option value="${c.id}">${esc(c.name)}</option>`).join('');$("#learnerClass").value=current}function openClass(id=''){const c=data.classes.find(x=>x.id===id);$("#classDialogTitle").textContent=c?'Edit class':'New class';$("#classId").value=c?.id||'';$("#className").value=c?.name||'';$("#classCourse").value=c?.course||'';$("#classDay").value=c?.day||'Monday';$("#classRoom").value=c?.room||'';$("#classStart").value=c?.start||'09:00';$("#classFinish").value=c?.finish||'15:00';$("#classDialog").showModal()}function openLearner(id=''){const l=data.learners.find(x=>x.id===id);$("#learnerDialogTitle").textContent=l?'Edit learner':'New learner';$("#learnerRecordId").value=l?.id||'';$("#firstName").value=l?.firstName||'';$("#surname").value=l?.surname||'';$("#learnerCourse").value=l?.course||'';$("#employer").value=l?.employer||'';fillClassSelect();$("#learnerClass").value=l?.classId||'';$("#learnerDialog").showModal()}function showQr(id){const l=data.learners.find(x=>x.id===id);if(!l)return;$("#qrLearnerName").textContent=`${l.firstName} ${l.surname}`;$("#qrId").textContent=l.linkId;const box=$("#qrCanvas");box.innerHTML='';if(window.QRCode)new QRCode(box,{text:`ASSESSORPLUS:${l.linkId}`,width:198,height:198,colorDark:'#2e1065',colorLight:'#ffffff',correctLevel:QRCode.CorrectLevel.H});else box.innerHTML=`<strong class="learner-id">${l.linkId}</strong>`;$("#qrDialog").showModal()}document.addEventListener('click',e=>{const b=e.target.closest('button,[data-action],[data-go]');if(!b)return;if(b.dataset.pageTarget)showPage(b.dataset.pageTarget);if(b.dataset.go)showPage(b.dataset.go);if(b.dataset.action==='new-class')openClass();if(b.dataset.action==='new-learner')openLearner();if(b.dataset.editClass)openClass(b.dataset.editClass);if(b.dataset.editLearner)openLearner(b.dataset.editLearner);if(b.dataset.showQr)showQr(b.dataset.showQr);if(b.dataset.deleteClass&&confirm('Delete this class template?')){data.classes=data.classes.filter(x=>x.id!==b.dataset.deleteClass);data.learners=data.learners.map(l=>l.classId===b.dataset.deleteClass?{...l,classId:''}:l);save(data);render();toast('Class deleted')}if(b.dataset.deleteLearner&&confirm('Delete this learner?')){data.learners=data.learners.filter(x=>x.id!==b.dataset.deleteLearner);save(data);render();toast('Learner deleted')}if(b.matches('[data-close]'))b.closest('dialog')?.close()});$("#classForm").addEventListener('submit',e=>{e.preventDefault();const id=$("#classId").value||uid(),record={id,name:$("#className").value.trim(),course:$("#classCourse").value.trim(),day:$("#classDay").value,room:$("#classRoom").value.trim(),start:$("#classStart").value,finish:$("#classFinish").value,updatedAt:new Date().toISOString()};const i=data.classes.findIndex(x=>x.id===id);i>=0?data.classes[i]=record:data.classes.push(record);save(data);closeDialogs();render();toast(i>=0?'Class updated':'Class created')});$("#learnerForm").addEventListener('submit',e=>{e.preventDefault();const id=$("#learnerRecordId").value||uid(),old=data.learners.find(x=>x.id===id),record={id,firstName:$("#firstName").value.trim(),surname:$("#surname").value.trim(),course:$("#learnerCourse").value.trim(),employer:$("#employer").value.trim(),classId:$("#learnerClass").value,linkId:old?.linkId||learnerId(),updatedAt:new Date().toISOString()};const i=data.learners.findIndex(x=>x.id===id);i>=0?data.learners[i]=record:data.learners.push(record);save(data);closeDialogs();render();toast(i>=0?'Learner updated':`Learner created · ID ${record.linkId}`)});$("#profileButton").addEventListener('click',()=>{const p=data.profile;$("#tutorName").value=p.name;$("#collegeName").value=p.college;$("#department").value=p.department;$("#profileDialog").showModal()});$("#profileForm").addEventListener('submit',e=>{e.preventDefault();data.profile={name:$("#tutorName").value.trim(),college:$("#collegeName").value.trim(),department:$("#department").value.trim()};save(data);closeDialogs();render();toast('Tutor profile saved')});$("#learnerSearch").addEventListener('input',renderLearners);$("#exportButton").addEventListener('click',()=>exportData(data));$("#importInput").addEventListener('change',async e=>{try{data=await importData(e.target.files[0]);render();toast('Backup restored')}catch(err){alert(err.message)}e.target.value=''});$("#resetButton").addEventListener('click',()=>{if(confirm('Delete all Assessor+ classes, learners and settings on this device?')){clearAll();data=load();render();toast('Assessor+ reset')}});window.addEventListener('beforeinstallprompt',e=>{e.preventDefault();deferred=e;$("#installButton").hidden=false;$("#dialogInstallButton").hidden=false});async function install(){if(!deferred){$("#installMessage").innerHTML='Open Chrome’s menu and choose <strong>Install app</strong> or <strong>Add to Home screen</strong>.';$("#installDialog").showModal();return}deferred.prompt();await deferred.userChoice;deferred=null;$("#installButton").hidden=true;$("#installDialog").close()}$("#installButton").addEventListener('click',install);$("#installRow").addEventListener('click',install);$("#dialogInstallButton").addEventListener('click',install);window.addEventListener('hashchange',()=>showPage(location.hash.slice(1)||'dashboard'));if('serviceWorker'in navigator)window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(console.error));showPage(location.hash.slice(1)||'dashboard');